generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model boats {
  boat_id       Int        @id @default(autoincrement())
  boat_name     String?    @db.VarChar
  boat_type     String?    @db.VarChar
  capacity      Int?
  price_per_day Int?
  bookings      bookings[]
  reviews       reviews[]
}

model bookings {
  booking_id  Int        @id(map: "boookings_pkey") @default(autoincrement())
  user_id     Int        @default(autoincrement())
  boat_id     Int        @default(autoincrement())
  start_date  DateTime?  @db.Date
  end_date    DateTime?  @db.Date
  total_price Int?
  status      String?    @db.VarChar
  created_at  DateTime?  @db.Date
  boats       boats      @relation(fields: [boat_id], references: [boat_id], onDelete: NoAction, onUpdate: NoAction, map: "boat_id")
  users       users      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "user_id")
  payments    payments[]
}

model locations {
  location_id   Int     @id @default(autoincrement())
  location_name String? @db.VarChar
  city          String? @db.VarChar
  country       String? @db.VarChar
  address       String?
}

model payments {
  payment_id     Int      @id @default(autoincrement())
  booking_id     Int      @default(autoincrement())
  amount         Decimal? @db.Decimal
  payment_method String?  @db.VarChar
  payment_status String?  @db.VarChar
  payment_date   String?  @db.VarChar
  bookings       bookings @relation(fields: [booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction, map: "booking_id")
}

model reviews {
  review_id  Int       @id @default(autoincrement())
  user_id    Int       @default(autoincrement())
  boat_id    Int       @default(autoincrement())
  rating     Int?
  comment    String?   @db.VarChar
  created_at DateTime? @db.Timestamptz(6)
  boats      boats     @relation(fields: [boat_id], references: [boat_id], onDelete: NoAction, onUpdate: NoAction, map: "boat_id")
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "user_id")
}

model users {
  user_id       Int        @id @default(autoincrement())
  first_name    String?    @db.VarChar
  last_name     String?    @db.VarChar
  email         String?    @unique(map: "unique_user_email") @db.VarChar
  password_hash String?    @db.VarChar
  phone         String?    @db.VarChar
  role          String?    @db.VarChar
  created_at    DateTime?  @db.Timestamptz(6)
  bookings      bookings[]
  reviews       reviews[]
}
